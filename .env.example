TRUST_PROXY_HEADERS=false
MAX_UPLOAD_SIZE=3145728
REKORDBOX_MAX_XML_MB=3
REQUEST_SIZE_LIMIT_BYTES=4400000
ENABLE_LOCAL_PATH_API=false
REKORDBOX_LOCAL_ROOT=

BACKEND_MAX_CONCURRENT_REQUESTS=2
REKORDBOX_CACHE_ENABLED=false
