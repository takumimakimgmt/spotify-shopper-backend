# Example only. Do NOT put real secrets here.
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://example.vercel.app
CORS_ALLOW_CREDENTIALS=true
SPOTIFY_CLIENT_ID=dummy
SPOTIFY_CLIENT_SECRET=dummy
BACKEND_PROXY_TOKEN=replace-with-a-long-random-value
REDIS_URL=
